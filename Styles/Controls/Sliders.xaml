<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Slider Thumb -->
    <Style x:Key="SliderThumbStyle"
           TargetType="Thumb">

        <Setter Property="Width" Value="18"/>
        <Setter Property="Height" Value="18"/>
        <Setter Property="Cursor" Value="Hand"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">

                    <Ellipse
                        x:Name="ThumbSurface"
                        Fill="{DynamicResource PrimaryTextBrush}"
                        Stroke="{DynamicResource BorderBrush}"
                        StrokeThickness="1"/>

                    <ControlTemplate.Triggers>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter
                                TargetName="ThumbSurface"
                                Property="Stroke"
                                Value="{DynamicResource FocusBrush}"/>

                            <Setter
                                TargetName="ThumbSurface"
                                Property="StrokeThickness"
                                Value="2"/>
                        </Trigger>

                        <Trigger Property="IsDragging" Value="True">
                            <Setter
                                TargetName="ThumbSurface"
                                Property="Opacity"
                                Value="0.85"/>
                        </Trigger>

                    </ControlTemplate.Triggers>

                </ControlTemplate>
            </Setter.Value>
        </Setter>

    </Style>

    <!-- Filled Slider -->
    <Style x:Key="SliderDecreaseButtonStyle"
           TargetType="RepeatButton">

        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Cursor" Value="Hand"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">

                    <Border
                        Height="18"
                        Margin="0,0,-9,0"
                        Background="{DynamicResource AccentBrush}"
                        CornerRadius="9,0,0,9"
                        VerticalAlignment="Center"/>

                </ControlTemplate>
            </Setter.Value>
        </Setter>

    </Style>

    <!-- Unfilled Slider -->
    <Style x:Key="SliderIncreaseButtonStyle"
           TargetType="RepeatButton">

        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Cursor" Value="Hand"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

    </Style>

    <!-- Standard Horizontal Slider -->
    <Style x:Key="SliderStyle"
           TargetType="Slider">

        <Setter Property="Height" Value="36"/>
        <Setter Property="MinWidth" Value="120"/>
        <Setter Property="IsMoveToPointEnabled" Value="True"/>
        <Setter Property="Focusable" Value="True"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="AutoToolTipPlacement" Value="None"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">

                    <Grid Margin="4,0">

                        <Border
                            x:Name="TrackBackground"
                            Height="24"
                            Background="{DynamicResource ElevatedSurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False"/>

                        <Track
                            x:Name="PART_Track"
                            Margin="3,0"
                            VerticalAlignment="Center"
                            Minimum="{TemplateBinding Minimum}"
                            Maximum="{TemplateBinding Maximum}"
                            Value="{Binding Value,
                                RelativeSource={RelativeSource TemplatedParent},
                                Mode=TwoWay}"
                            Orientation="Horizontal"
                            IsDirectionReversed="{TemplateBinding IsDirectionReversed}">

                            <Track.DecreaseRepeatButton>
                                <RepeatButton
                                    Style="{StaticResource SliderDecreaseButtonStyle}"
                                    Command="Slider.DecreaseLarge"/>
                            </Track.DecreaseRepeatButton>

                            <Track.Thumb>
                                <Thumb
                                    Style="{StaticResource SliderThumbStyle}"/>
                            </Track.Thumb>

                            <Track.IncreaseRepeatButton>
                                <RepeatButton
                                    Style="{StaticResource SliderIncreaseButtonStyle}"
                                    Command="Slider.IncreaseLarge"/>
                            </Track.IncreaseRepeatButton>

                        </Track>

                    </Grid>

                    <ControlTemplate.Triggers>

                        <!-- Disabled -->
                        <Trigger Property="IsEnabled"
                                Value="False">
                            <Setter Property="Opacity"
                                    Value="0.45"/>
                        </Trigger>

                    </ControlTemplate.Triggers>

                </ControlTemplate>
            </Setter.Value>
        </Setter>

    </Style>

</ResourceDictionary>
