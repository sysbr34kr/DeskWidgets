<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dark theme (default) -->
    <SolidColorBrush
        x:Key="MainBackgroundBrush"
        Color="#101010"/>

    <SolidColorBrush
        x:Key="CardBackgroundBrush"
        Color="#1D1D1D"/>

    <SolidColorBrush
        x:Key="ElevatedSurfaceBrush"
        Color="#292929"/>

    <SolidColorBrush
        x:Key="AccentBrush"
        Color="#B9B9B9"/>

    <SolidColorBrush
        x:Key="PrimaryTextBrush"
        Color="#F5F5F5"/>

    <SolidColorBrush
        x:Key="SecondaryTextBrush"
        Color="#999999"/>

    <SolidColorBrush
        x:Key="BorderBrush"
        Color="#343434"/>

    <SolidColorBrush
        x:Key="FocusBrush"
        Color="FFFFFF"/>
    
</ResourceDictionary>
