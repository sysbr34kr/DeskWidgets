
<UserControl
    x:Class="DeskWidgets.Widgets.DigitalClock.DigitalClockCard"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
    xmlns:controls="clr-namespace:DeskWidgets.Controls"
    xmlns:local="clr-namespace:DeskWidgets.Widgets.DigitalClock">

    <controls:WidgetCard
        WidgetTitle="{DynamicResource Clock_Name}"
        WidgetDescription="{DynamicResource Clock_Description}"
        IconGlyph="&#xE823;"
        IsSettingsExpanded="{Binding IsSettingsExpanded,
            ElementName=Root,
            Mode=TwoWay}"
        DataContext="{Binding Settings, ElementName=Root}"
        IsWidgetEnabled="{Binding IsEnabled, Mode=TwoWay}">

        <controls:WidgetCard.SettingsContent>

            <StackPanel>
                
                <TextBlock
                    Text="{DynamicResource Clock_Display}"
                    Style="{StaticResource SectionTitleStyle}"
                    Margin="0,0,0,14"/>

                <controls:SettingSlider
                    Label="{DynamicResource Clock_FontSize}"
                    Minimum="16"
                    Maximum="100"
                    Value="{Binding FontSize, Mode=TwoWay}"
                    Step="1"
                    Margin="0,0,0,16"/>

                <controls:SettingToggle
                    Label="{DynamicResource Clock_ShowSeconds}"
                    IsChecked="{Binding ShowSeconds, Mode=TwoWay}"
                    Margin="0,0,0,10"/>

                <controls:SettingToggle
                    Label="{DynamicResource Clock_Use24Hour}"
                    IsChecked="{Binding Use24HourFormat, Mode=TwoWay}"
                    Margin="0,0,0,10"/>

                <controls:SettingToggle
                    Label="{DynamicResource Clock_ShowDate}"
                    IsChecked="{Binding ShowDate, Mode=TwoWay}"/>

                <controls:SettingComboBox
                    Label="{DynamicResource Clock_DateFormat}"
                    ComboBoxWidth="170"
                    ItemsSource="{x:Static local:DigitalClockCard.DateFormatOptions}"
                    DisplayMemberPath="Label"
                    SelectedValuePath="Value"
                    SelectedValue="{Binding DateFormat, Mode=TwoWay}"
                    IsEnabled="{Binding ShowDate}"
                    Margin="0,12,0,0"/>

                <!-- Shared Widget Behaviors -->
                <Border
                    Height="1"
                    Background="{DynamicResource BorderBrush}"
                    Margin="0,20,0,20"/>

                <controls:WidgetBehaviorSettings
                    IsPositionLocked="{Binding IsPositionLocked, Mode=TwoWay}"
                    IsBackgroundTransparent="{Binding IsBackgroundTransparent, Mode=TwoWay}"
                    IsAlwaysOnTop="{Binding IsAlwaysOnTop, Mode=TwoWay}"
                    ResetPositionRequested="BehaviorSettings_ResetPositionRequested"/>

            </StackPanel>

        </controls:WidgetCard.SettingsContent>

    </controls:WidgetCard>

</UserControl>
