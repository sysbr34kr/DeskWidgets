<UserControl
    x:Class="DeskWidgets.Controls.SettingSlider"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel>

        <!-- Label and Current Value -->
        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Setting Label -->
            <TextBlock
                x:Name="SettingLabel"
                Grid.Column="0"
                Text="{Binding Label, ElementName=Root}"
                Style="{StaticResource SettingLabelStyle}"
                FontWeight="Normal"
                VerticalAlignment="Center"
                Margin="0,0,12,0"/>

            <!-- Current Value -->
            <TextBlock
                Grid.Column="1"
                Text="{Binding Value, ElementName=Root,
                    StringFormat={}{0:0}}"
                Style="{StaticResource DescriptionStyle}"
                FontSize="14"
                VerticalAlignment="Center"/>

        </Grid>

        <!-- Slider -->
        <Slider
            Style="{StaticResource SliderStyle}"
            Minimum="{Binding Minimum, ElementName=Root}"
            Maximum="{Binding Maximum, ElementName=Root}"
            Value="{Binding Value, ElementName=Root, Mode=TwoWay}"
            TickFrequency="{Binding Step, ElementName=Root}"
            SmallChange="{Binding Step, ElementName=Root}"
            IsSnapToTickEnabled="True"
            AutomationProperties.LabeledBy="{Binding ElementName=SettingLabel}"/>

    </StackPanel>

</UserControl>
