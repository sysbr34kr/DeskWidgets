<UserControl
    x:Class="DeskWidgets.Controls.SettingComboBox"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid MinHeight="36">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Setting Label -->
        <TextBlock
            x:Name="SettingLabel"
            Grid.Column="0"
            Text="{Binding Label, ElementName=Root}"
            Style="{StaticResource SettingLabelStyle}"
            FontWeight="Normal"
            VerticalAlignment="Center"
            TextWrapping="Wrap"
            Margin="0,0,16,0"/>

        <!-- Setting Dropdown -->
        <ComboBox
            Grid.Column="1"
            Width="{Binding ComboBoxWidth, ElementName=Root}"
            Style="{StaticResource ComboBoxStyle}"
            ItemsSource="{Binding ItemsSource, ElementName=Root}"
            DisplayMemberPath="{Binding DisplayMemberPath, ElementName=Root}"
            SelectedValuePath="{Binding SelectedValuePath, ElementName=Root}"
            SelectedValue="{Binding SelectedValue,
                ElementName=Root,
                Mode=TwoWay}"
            AutomationProperties.LabeledBy="{Binding ElementName=SettingLabel}"
            VerticalAlignment="Center"/>

    </Grid>

</UserControl>
